{
  "schema_version": 2,
  "id": "ai.agent",
  "name": "AI Agent",
  "description": "CPU-first AI Agent with slim bundled Ollama; automatic Qwen3 0.6B bootstrap, selectable models and optional NVIDIA GPU runtime.",
  "version": "0.3.1",
  "core": ">=0.1.189 <1.0.0",
  "runtime": {
    "type": "docker",
    "docker": {
      "image": "ghcr.io/deadsoulf/home-ai-core-ai@sha256:a1aafe7d847d284f03d85e3d0162f4704e8bec4c97047768d6992c38e9981f40"
    },
    "health": {
      "port": 8080,
      "path": "/health"
    }
  },
  "dependencies": [],
  "conflicts": [],
  "permissions": [
    "ai.chat",
    "ai.providers.manage",
    "ai.actions.approve"
  ],
  "capabilities": {
    "requires": [
      "host.docker"
    ],
    "provides": [
      "ai.agent",
      "ai.chat",
      "ai.providers"
    ]
  },
  "host": {
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "api": {
    "namespace": "ai.agent"
  },
  "ui": {
    "navigation": [
      {
        "id": "ai.agent",
        "title": "AI Agent",
        "route": "/modules/ai.agent",
        "icon": "brain-circuit",
        "order": 60
      }
    ]
  },
  "lifecycle": [
    "install",
    "upgrade",
    "remove",
    "start",
    "stop",
    "restart"
  ]
}
